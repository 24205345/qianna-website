# Supabase 连接配置 —— 复制本文件为 .env.local 并填入真实值
# 在 Supabase 控制台 Project Settings → API 中获取
#
# 注意：以 NEXT_PUBLIC_ 开头的变量会被打包进浏览器端代码，
# 因此这里只能放“可公开”的匿名密钥（anon / publishable key），
# 绝对不要把 service_role / secret key 放进 NEXT_PUBLIC_ 变量。

# 站点 canonical URL（SEO / sitemap / Open Graph）
NEXT_PUBLIC_SITE_URL=https://www.qiannawang.com

# 项目 URL，形如 https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# 匿名公开密钥（anon public key）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 仅本地迁移脚本 migrate:media 使用（勿提交真实密码）
SUPABASE_ADMIN_EMAIL=
SUPABASE_ADMIN_PASSWORD=

# Cloudflare Turnstile（Guestbook 真人验证，可选）
# 未配置时本地 dev 与旧版行为一致（无 widget）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Default supabase; switch new uploads after bucket/domain verification.
MEDIA_STORAGE_PROVIDER=supabase
# Optional independent static-file delivery: local or r2; defaults to MEDIA_STORAGE_PROVIDER.
STATIC_MEDIA_PROVIDER=
## Optional for local proxy DNS; production always keeps image optimization.
DEV_IMAGE_UNOPTIMIZED=false
# Server-only credentials; NEVER prefix with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=portfolio-media
# Public custom domain, e.g. https://media.qiannawang.com
# Set while provider=supabase so next/image accepts migrated URLs.
R2_PUBLIC_BASE_URL=
