<mxfile><diagram name="Workbench"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="client" value="客户端&#10;输入、作答、回顾与恢复&#10;不保存服务端密钥" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#838383;fontColor=#202020;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="235" height="170" as="geometry"/></mxCell><mxCell id="server" value="可信的应用服务端" style="swimlane;startSize=38;horizontal=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#838383;fontColor=#202020;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="370" y="25" width="310" height="340" as="geometry"/></mxCell><mxCell id="checks" value="校验输入与权限&#10;使用服务端密钥调用&#10;校验生成结果" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#838383;fontColor=#202020;fontFamily=Arial;fontSize=16;" vertex="1" parent="server"><mxGeometry x="30" y="70" width="250" height="230" as="geometry"/></mxCell><mxCell id="external" value="生成服务&#10;候选内容&#10;可能失败或超时" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#838383;fontColor=#202020;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="810" y="90" width="210" height="170" as="geometry"/></mxCell><mxCell id="edge0" value="输入 / 结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#838383;endArrow=classic;startArrow=classic;fontColor=#646464;" edge="1" parent="1" source="client" target="checks"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge1" value="请求生成 / 候选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#838383;endArrow=classic;startArrow=classic;fontColor=#646464;" edge="1" parent="1" source="checks" target="external"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
